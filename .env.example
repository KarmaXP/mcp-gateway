# =============================================================================
# MCP Gateway — environment variables
# Copy to .env and adjust. Never commit .env to git.
#
# Go binary reads the variables in the "Gateway (Go)" section. Names must match
# exactly (see cmd/gateway/main.go, internal/auth, internal/telemetry).
# =============================================================================

# --- Backends (required) ---
# YAML file (make run defaults to deployments/gateway.demo.yaml if unset).
# Use gateway.example.yaml when alpha/beta mocks listen on 3101/3102 (make demo-backends).
MCP_GATEWAY_CONFIG=deployments/gateway.demo.yaml
# Or inline JSON (merged after YAML if both set):
# MCP_GATEWAY_BACKENDS='[{"id":"alpha","prefix":"alpha","url":"http://127.0.0.1:3101","max_concurrency":8}]'

# --- Gateway (Go) — HTTP listen ---
# Port the process binds to (inside Docker the image expects 8080; see Dockerfile).
PORT=8080
# Used by Makefile `stop` (lsof); keep in sync with PORT for local dev.
GATEWAY_PORT=8080

# --- Semantic router (Go) ---
# off by default; set to on, assist_list, or filter_list to enable vector routing / intent-filtered tools/list.
# When ROUTER_MODE is on, assist_list, or filter_list, QDRANT_URL is required (HTTP vector store).
# ROUTER_MODE=on
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=mcp_tool_catalog
# Embedding sidecar (must match HOST_PORT_EMBED mapping if not default 8001).
EMBED_URL=http://127.0.0.1:8001
# Optional overrides (defaults are safe for local dev / local ONNX):
# ROUTER_VECTOR_DIM=384
# Router tuning (optional; defaults match gateway.example.yaml until calibration):
# ROUTER_SCORE_MIN=0.35
# ROUTER_TOP_K=8
# ROUTER_HYBRID_ALPHA=0.2
# ROUTER_ALLOW_AUTO_RENAME=true

# --- OpenTelemetry (Go) ---
# If unset, traces/metrics are not exported (SDK still initializes for propagation).
# Local collector (docker-up): OTLP HTTP on host 4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME is merged via OTEL_RESOURCE_ATTRIBUTES / semconv in SDK;
# service name is also set in code; you may set this for your deployment.
OTEL_SERVICE_NAME=mcp-gateway
# Note: OTEL_EXPORTER_OTLP_PROTOCOL is honored by many OTLP clients; this binary
# uses OTLP HTTP exporters from go.opentelemetry.io — ensure the collector listens on :4318.

# --- Security / JWT (Go) ---
# AUTH_MODE=none   # default when unset — no bearer required
# AUTH_MODE=jwt
# For RS256 with a static public key (local dev):
# JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Or JWKS (kid header required on tokens):
# JWT_JWKS_URL=https://your-idp/.well-known/jwks.json
# JWT_JWKS_CACHE_TTL=5m
# JWKS failures are fail-closed (401) in jwt mode; no AUTH_ALLOW_JWKS_UNAVAILABLE bypass exists.
# Optional claim checks:
# JWT_ISS=https://your-idp
# JWT_AUD=mcp-gateway
# Optional: JSON array of namespaced tool ids for semantic-router allow-list (§3.C → §3.B):
#   "mcp_tools": ["k8s__get_logs", "prom__query_range"]
# Omitted or empty = no allow-list filter (all aggregated tools visible to routing).
# Optional: OAuth RAR-style granular consent (RFC 9396) as JSON array on claim authorization_details:
#   [{"type":"mcp_tool","tool_name":"k8s__get_logs"}]
#   or {"type":"mcp_tool","tool_pattern":"prom__*"} — merged with mcp_tools (intersection when both are set).
# Optional: mcp_tool_groups — expands via gateway policy.tool_groups in MCP_GATEWAY_CONFIG YAML.

# --- Policy engine (YAML policy: block + env overrides) ---
# Version string for audit logs / traces (also set in deployments/gateway.example.yaml under policy:).
# POLICY_VERSION=2026-05-01
# Optional audit sink selection:
# POLICY_AUDIT_SINK=slog               # slog (default) | syslog
# POLICY_AUDIT_SYSLOG_NETWORK=udp      # default udp; used when sink=syslog
# POLICY_AUDIT_SYSLOG_ADDRESS=127.0.0.1:514  # required when sink=syslog
# Dev-only: if authorization_details JSON is malformed, fall back to mcp_tools only instead of 401 (SEC7 degradation).
# POLICY_ALLOW_ON_EVAL_FAILURE=false
# Enforce additionalProperties=false on object schemas for elevated tools at compile time.
# POLICY_HARDEN_SCHEMAS=false

# --- Rate limiting (optional, §4.6 abuse protection) ---
# When enabled, token-bucket per JWT sub (or RemoteAddr if AUTH_MODE=none) on MCP routes; health paths excluded.
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_RPS=100
# RATE_LIMIT_BURST=200

# --- Infra / Docker Compose (not read by Go yet unless you wire a Qdrant store) ---
# Qdrant — gateway uses HTTP JSON API (see internal/router/store/qdrant.go); gRPC port is for other tools
# QDRANT_HOST=localhost
# QDRANT_GRPC_PORT=6334
# QDRANT_HTTP_PORT=6333
# QDRANT_COLLECTION=mcp_tools
# QDRANT_DISTANCE=Cosine
# QDRANT_VECTOR_DIM=384

# Host port overrides (compose file substitutions only)
# HOST_PORT_QDRANT_HTTP=6333
# HOST_PORT_QDRANT_GRPC=6334
# HOST_PORT_EMBED=8001
# HOST_PORT_OTLP_GRPC=4317
# HOST_PORT_OTLP_HTTP=4318
# HOST_PORT_PROMETHEUS=9090
# HOST_PORT_GRAFANA=3000
# HOST_PORT_GATEWAY=8080

# LOG_LEVEL=info   # not wired in main.go yet (slog level is fixed to info)
