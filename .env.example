# MCP Gateway — copy to .env and adjust (never commit .env).
# Variable reference: docs/configuration.md

# --- Core ---
# Demo (default): gateway.demo.yaml + smoke_upstream on :31400
# Multi-upstream: gateway.example.yaml | SRE: gateway.sre.example.yaml | JWT lab: gateway.real.yaml
MCP_GATEWAY_CONFIG=deployments/gateway.demo.yaml
PORT=8080
GATEWAY_PORT=8080
# Appends upstreams to the YAML ones, as a JSON array. It does not replace them.
# MCP_GATEWAY_BACKENDS=[{"id":"extra","prefix":"x","url":"http://127.0.0.1:3103"}]
# Comma-separated browser origins allowed on /mcp/*. Unset means no browser origin is allowed.
# GATEWAY_ALLOWED_ORIGINS=https://app.example.com

# --- OpenTelemetry ---
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable export (propagation still works).
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=mcp-gateway

# --- Semantic router ---
# Requires QDRANT_URL when ROUTER_MODE is on, assist_list, or filter_list.
EMBED_URL=http://127.0.0.1:8001
# ROUTER_MODE=on
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=mcp_tool_catalog

# --- JWT (AUTH_MODE=jwt) ---
# See docs/configuration.md#authentication and docs/adr/0003-security-rar-jwt-merge-failmode.md
# AUTH_MODE=jwt
# JWT_PUBLIC_KEY_FILE=/tmp/mcp-lab-jwt.pub.pem
# JWT_ISS=https://lab.local
# JWT_AUD=mcp-gateway
# JWT_JWKS_URL=https://your-idp/.well-known/jwks.json
# JWT_JWKS_CACHE_TTL=5m
# JWT_PUBLIC_KEY_PEM and JWT_PUBLIC_KEY_FILE are alternatives; the file wins when both are set.
# Prefer the file: a PEM is multi-line, and this loader reads JWT_PUBLIC_KEY_PEM verbatim, so an
# escaped "\n" stays two characters and the key fails to parse.
# Exactly one of the static key and JWKS_URL may be set.
# JWT_ISS and JWT_AUD are required when AUTH_MODE=jwt.
# A token with no mcp_tools, mcp_tool_groups or authorization_details is allowed no tools;
# use mcp_tools: ["*"] for the full catalog.

# --- Policy audit ---
# Keys the subject pseudonym in audit records. Keep it stable for a deployment.
# POLICY_AUDIT_SUBJECT_PEPPER=change-me

# --- Optional overrides (defaults match deployments/gateway.example.yaml) ---
# ROUTER_TOP_K=8
# ROUTER_SCORE_MIN=0.35
# ROUTER_HYBRID_ALPHA=0.2
# ROUTER_ALLOW_AUTO_RENAME=true
# Catalog used by cmd/gen-router-eval-catalog, not by the gateway itself.
# ROUTER_EVAL_CATALOG_PATH=docs/evaluation/router-eval-catalog.json
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_RPS=100
# LOG_LEVEL=info

# --- JWT lab (.env snippet; see docs/evaluation/scenario-real-upstreams-jwt.md) ---
# MCP_GATEWAY_CONFIG=deployments/gateway.real.yaml
# PORT=18080
# ROUTER_MODE=on
# AUTH_MODE=jwt
# JWT_PUBLIC_KEY_FILE=/tmp/mcp-lab-jwt.pub.pem
# JWT_ISS=https://lab.local
# JWT_AUD=mcp-gateway
# HOST_PORT_EMBED=18001
# EMBED_URL=http://127.0.0.1:18001

# --- Docker Compose host ports (compose substitutions only) ---
# HOST_PORT_GATEWAY=8080
# HOST_PORT_QDRANT_HTTP=6333
# HOST_PORT_EMBED=8001
# HOST_PORT_OTLP_HTTP=4318
# HOST_PORT_PROMETHEUS=9090
# HOST_PORT_GRAFANA=3000
